+    def _differs(v1, v2):
+        if v1 is v2:
+            return False
+        try:
+            res = (v1 != v2)
+            if isinstance(res, (bool, np.bool_)):
+                return res
+            if hasattr(res, "any"):
+                return bool(res.any())
