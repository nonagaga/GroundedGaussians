+# --------------------------------------------------------------------------- #
+# Differentiable Spline Fitting & Exact Integrated L2 Loss
+# --------------------------------------------------------------------------- #
+BERNSTEIN_GRAM_4x4 = torch.tensor(
+    [
+        [20.0, 10.0, 4.0, 1.0],
+        [10.0, 12.0, 9.0, 4.0],
+        [4.0, 9.0, 12.0, 10.0],
+        [1.0, 4.0, 10.0, 20.0],
+    ],
