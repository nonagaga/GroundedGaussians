+            continue
+        val = getattr(cfg, f.name)
+        dval = getattr(base_cfg, f.name)
+        if _differs(val, dval):
+            overrides.append((f.name, dval, val))
+
+    if hasattr(cfg, "strategy") and hasattr(base_cfg, "strategy"):
