+#!/usr/bin/env python3
+"""
+spline_fit.py - Generalized N-Segment Tangent-Continuous (C1) Cubic Spline Fitting & Centerline Extraction.
+
+Provides modular, high-performance spline fitting, evaluation, and track segmentation
+utilities for use across analysis scripts (compare_models.py, splines.py) and PyTorch
+training pipelines (simple_trainer.py).
+
+Key Capabilities:
+  1. Generalized N-Segment Cubic Splines:
+     - Global linear least-squares fitting of arbitrary N segments (N >= 1).
+     - Strict C0 (position) and C1 (tangent vector) continuity at all junctions.
+     - Optional endpoint pinning (start/end points) or unconstrained fitting.
+  2. Exact Continuous L2 Error Metric:
+     - Integrated analytical L2 difference between two N-segment splines using the
+       Bernstein Gram matrix (closed-form, no sampling approximation).
+  3. Robust Centerline Extraction:
+     - Pre-filtered morphological closing + connected components to eliminate isolated noise.
+     - Spatial continuity tracking (max_jump_px) to ignore split clusters/reflections.
+     - Vertical gap termination (max_gap_rows) to prevent snapping into the horizon.
+     - Dual backends: 'scan' (fast robust row scanner) and 'skeleton' (geodesic graph BFS).
+  4. PyTorch Differentiable Backend:
+     - Differentiable analogue using torch.linalg.lstsq when PyTorch is available.
+
+Usage as module:
+  from spline_fit import (
+      fit_n_cubic_splines,
+      extract_centerline_points,
+      extract_orange_pixels,
+      compute_exact_integrated_l2,
+      draw_spline_curve,
+  )
+
+  ctrl_pts = fit_n_cubic_splines(norm_pts, num_segments=4, continuity="C1")
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import sys
+from collections import deque
+from pathlib import Path
+
+import cv2
+import numpy as np
+
+# Optional PyTorch import for differentiable training pipelines
+try:
+    import torch
+    TORCH_AVAILABLE = True
+except ImportError:
+    TORCH_AVAILABLE = False
+
+
+# --------------------------------------------------------------------------- #
+# Bernstein Basis & Gram Matrix Constants
+# --------------------------------------------------------------------------- #
+# Exact analytical Gram matrix for cubic Bernstein polynomials on [0, 1]:
+# M_ij = integral_0^1 B_i(u) * B_j(u) du
+BERNSTEIN_GRAM_4x4 = np.array(
+    [
+        [20.0, 10.0, 4.0, 1.0],
+        [10.0, 12.0, 9.0, 4.0],
+        [4.0, 9.0, 12.0, 10.0],
+        [1.0, 4.0, 10.0, 20.0],
+    ],
+    dtype=np.float64,
+) / 140.0
+
+
+def cubic_bezier_basis(u: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
+    """
+    Compute the 4 cubic Bernstein basis functions B_0(u), B_1(u), B_2(u), B_3(u) for u in [0, 1].
+    """
+    u_c = np.clip(u, 0.0, 1.0)
+    one_minus_u = 1.0 - u_c
+    b0 = one_minus_u ** 3
+    b1 = 3.0 * (one_minus_u ** 2) * u_c
+    b2 = 3.0 * one_minus_u * (u_c ** 2)
+    b3 = u_c ** 3
+    return b0, b1, b2, b3
+
+
+def compute_chord_parameters(points: np.ndarray) -> np.ndarray:
+    """
+    Compute normalized cumulative chord-length parameter u in [0, 1] for a sequence of 2D points.
+    """
+    if len(points) <= 1:
+        return np.zeros(len(points), dtype=np.float64)
+    diffs = np.diff(points, axis=0)
+    chords = np.concatenate(([0.0], np.cumsum(np.hypot(diffs[:, 0], diffs[:, 1]))))
+    total_len = chords[-1]
+    if total_len <= 1e-9 or np.isnan(total_len):
+        return np.linspace(0.0, 1.0, len(points), dtype=np.float64)
+    return chords / total_len
+
+
+def resample_path(pts: np.ndarray, num_samples: int = 48) -> np.ndarray:
+    """Resample path coordinates uniformly along arc/chord length."""
+    if len(pts) <= 1:
+        return pts
+    u_orig = compute_chord_parameters(pts)
+    u_new = np.linspace(0.0, 1.0, num_samples)
+    x_new = np.interp(u_new, u_orig, pts[:, 0])
+    y_new = np.interp(u_new, u_orig, pts[:, 1])
+    return np.column_stack([x_new, y_new])
+
+
+# --------------------------------------------------------------------------- #
+# Generalized N-Segment Tangent-Continuous (C1) Cubic Spline Fitting
+# --------------------------------------------------------------------------- #
+def fit_n_cubic_splines(
+    points: np.ndarray,
+    num_segments: int = 3,
+    continuity: str = "C1",
+    pin_endpoints: bool = True,
+) -> np.ndarray:
+    """
+    Fit N sequential cubic Bezier curves to 2D points with exact continuity constraints.
+
+    Args:
+        points: Array of shape [N, 2] in normalized coordinates [0, 1] x [0, 1].
+        num_segments: Number of cubic segments N >= 1 (e.g. 1, 2, 3, 4, 5).
+        continuity:
+          - 'C1': Position (C0) AND tangent vector (C1) continuous across all junctions.
+                  Ensures matching first derivatives: P_{s, 1} = 2 * J_s - P_{s-1, 2}.
+          - 'C0': Position continuous only (shared junction points J_s = P_{s-1, 3} = P_{s, 0}).
+        pin_endpoints: If True, locks P_{0,0} = points[0] and P_{N-1,3} = points[-1].
+
+    Returns:
+        ctrl_pts: Array of shape [num_segments, 4, 2] containing control points for each segment.
+    """
+    n_pts = len(points)
+    if num_segments < 1:
+        raise ValueError("num_segments must be >= 1")
+
+    # Handle short or degenerate point sets
+    if n_pts < 2:
+        pt = points[0] if n_pts == 1 else np.array([0.5, 0.5], dtype=np.float64)
+        return np.tile(pt, (num_segments, 4, 1))
+
+    if n_pts < 4:
+        p0 = points[0]
+        p3 = points[-1]
+        t_vals = np.linspace(0.0, 1.0, num_segments + 1)
+        juncs = [p0 + (p3 - p0) * t for t in t_vals]
+        out = []
+        for s in range(num_segments):
+            s0 = juncs[s]
+            s3 = juncs[s + 1]
+            s1 = s0 + (s3 - s0) * (1.0 / 3.0)
+            s2 = s0 + (s3 - s0) * (2.0 / 3.0)
+            out.append([s0, s1, s2, s3])
+        return np.array(out, dtype=np.float64)
+
+    # Chord-length parameterization
+    u_global = compute_chord_parameters(points)
+    seg_breaks = np.linspace(0.0, 1.0, num_segments + 1)
+
+    # Assign points to segments based on parameter range
+    seg_indices = np.clip(np.floor(u_global * num_segments).astype(int), 0, num_segments - 1)
+    u_local = (u_global - seg_breaks[seg_indices]) / (seg_breaks[seg_indices + 1] - seg_breaks[seg_indices])
+    u_local = np.clip(u_local, 0.0, 1.0)
+
+    b0, b1, b2, b3 = cubic_bezier_basis(u_local)
+
+    # ----------------------------------------------------------------------- #
+    # Parameterization of Global Linear Least Squares System
+    # ----------------------------------------------------------------------- #
+    p_start = points[0] if pin_endpoints else None
+    p_end = points[-1] if pin_endpoints else None
+
+    if continuity.upper() == "C1":
+        # C1 Tangent Continuity:
+        # Segment 0: P_{0,0}, P_{0,1}, P_{0,2}, J_1
+        # Segment s: P_{s,0} = J_s, P_{s,1} = 2*J_s - P_{s-1,2}, P_{s,2}, J_{s+1}
+        # Last segment: P_{n-1,3}
+        #
+        # Free variables indexing:
+        # If pin_endpoints:
+        #   idx 0: P_{0,1}
+        #   idx 1: P_{0,2}
+        #   idx 2: J_1 (if n > 1)
+        #   For s in 1..num_segments-1:
+        #     idx 2*s: J_s
+        #     idx 2*s - 1: P_{s-1, 2}
+        #     idx 2*s + 1: P_{s, 2}
+        n_vars = 2 * num_segments if pin_endpoints else 2 * num_segments + 2
+
+        coeff = np.zeros((num_segments, 4, n_vars), dtype=np.float64)
+        const = np.zeros((num_segments, 4, 2), dtype=np.float64)
+
+        if pin_endpoints:
+            const[0, 0] = p_start
+            coeff[0, 1, 0] = 1.0  # P_{0,1}
+            coeff[0, 2, 1] = 1.0  # P_{0,2}
+
+            if num_segments == 1:
+                const[0, 3] = p_end
+            else:
+                coeff[0, 3, 2] = 1.0  # J_1
+
+            for s in range(1, num_segments):
+                idx_Js = 2 * s
+                idx_prev_p2 = 2 * s - 1
+                idx_ps2 = 2 * s + 1
+
+                # P_{s,0} = J_s
+                coeff[s, 0, idx_Js] = 1.0
+                # P_{s,1} = 2*J_s - P_{s-1,2}  (exact C1 tangent derivative continuity)
+                coeff[s, 1, idx_Js] += 2.0
+                coeff[s, 1, idx_prev_p2] -= 1.0
+                # P_{s,2} is free
+                coeff[s, 2, idx_ps2] = 1.0
+
+                # P_{s,3}
+                if s == num_segments - 1:
+                    const[s, 3] = p_end
+                else:
+                    idx_next_J = 2 * (s + 1)
+                    coeff[s, 3, idx_next_J] = 1.0
+        else:
+            # Unconstrained endpoints: P_{0,0} and P_{n-1,3} are also free variables
+            coeff[0, 0, 0] = 1.0
+            coeff[0, 1, 1] = 1.0
+            coeff[0, 2, 2] = 1.0
+            if num_segments == 1:
+                coeff[0, 3, 3] = 1.0
+            else:
+                coeff[0, 3, 3] = 1.0
+                for s in range(1, num_segments):
+                    idx_Js = 2 * s + 1
+                    idx_prev_p2 = 2 * s
+                    idx_ps2 = 2 * s + 2
+                    coeff[s, 0, idx_Js] = 1.0
+                    coeff[s, 1, idx_Js] += 2.0
+                    coeff[s, 1, idx_prev_p2] -= 1.0
+                    coeff[s, 2, idx_ps2] = 1.0
+                    if s == num_segments - 1:
+                        coeff[s, 3, 2 * s + 3] = 1.0
+                    else:
+                        coeff[s, 3, 2 * (s + 1) + 1] = 1.0
+
+    else:
+        # C0 Continuity Only:
+        # Each segment has independent P_{s,1} and P_{s,2}, sharing only J_s = P_{s-1,3} = P_{s,0}
+        n_vars = 3 * num_segments - 1 if pin_endpoints else 3 * num_segments + 1
+        coeff = np.zeros((num_segments, 4, n_vars), dtype=np.float64)
+        const = np.zeros((num_segments, 4, 2), dtype=np.float64)
+
+        var_idx = 0
+        if pin_endpoints:
+            const[0, 0] = p_start
+        else:
+            coeff[0, 0, var_idx] = 1.0
+            var_idx += 1
+
+        for s in range(num_segments):
+            if s > 0:
+                # P_{s,0} = J_s = P_{s-1,3}
+                coeff[s, 0] = coeff[s - 1, 3]
+
+            coeff[s, 1, var_idx] = 1.0
+            var_idx += 1
+            coeff[s, 2, var_idx] = 1.0
+            var_idx += 1
+
+            if s == num_segments - 1 and pin_endpoints:
+                const[s, 3] = p_end
+            else:
+                coeff[s, 3, var_idx] = 1.0
+                var_idx += 1
+
+    # Build linear system A @ X = B
+    A = np.zeros((n_pts, n_vars), dtype=np.float64)
+    B = points.copy().astype(np.float64)
+
+    for i in range(n_pts):
+        s = seg_indices[i]
+        c_i = b0[i] * coeff[s, 0] + b1[i] * coeff[s, 1] + b2[i] * coeff[s, 2] + b3[i] * coeff[s, 3]
+        A[i] = c_i
+        const_i = b0[i] * const[s, 0] + b1[i] * const[s, 1] + b2[i] * const[s, 2] + b3[i] * const[s, 3]
+        B[i] -= const_i
+
+    # Linear least-squares solve
+    X, _, _, _ = np.linalg.lstsq(A, B, rcond=None)
+
+    # Reconstruct all control points [num_segments, 4, 2]
+    ctrl_pts = np.zeros((num_segments, 4, 2), dtype=np.float64)
+    for s in range(num_segments):
+        for k in range(4):
+            ctrl_pts[s, k] = coeff[s, k] @ X + const[s, k]
+
+    return ctrl_pts
+
+
+def fit_three_cubic_bsplines_numpy(norm_pts: np.ndarray) -> np.ndarray:
+    """
+    Backward-compatible convenience wrapper: fits 3 C1 tangent-continuous cubic splines.
+    Returns: [3, 4, 2] control points.
+    """
+    return fit_n_cubic_splines(norm_pts, num_segments=3, continuity="C1", pin_endpoints=True)
+
+
+# --------------------------------------------------------------------------- #
+# Exact Integrated Continuous L2 Error Metric
+# --------------------------------------------------------------------------- #
+def compute_exact_integrated_l2(
+    ctrl_a: np.ndarray,
+    ctrl_b: np.ndarray,
+    img_w: float | None = None,
+    img_h: float | None = None,
+) -> tuple[float, float]:
+    """
+    Calculate exact integrated continuous L2 error between two N-segment cubic Bezier splines
+    using the closed-form Bernstein Gram matrix.
+
+    Integral over [0, 1]:
+      E^2 = sum_{s=0}^{N-1} integral_0^1 || C_s^A(u) - C_s^B(u) ||^2 du
+          = sum_{s=0}^{N-1} (dx_s^T @ M @ dx_s + dy_s^T @ M @ dy_s)
+
+    Args:
+        ctrl_a: [N, 4, 2] control points of curve A.
+        ctrl_b: [N, 4, 2] control points of curve B.
+        img_w: Width scale in pixels (optional, converts normalized error to pixel error).
+        img_h: Height scale in pixels (optional).
+
+    Returns:
+        err_norm: Mean integrated L2 error in normalized [0, 1] image coordinates.
+        err_px: Mean integrated L2 error scaled to original image pixel dimensions.
+    """
+    if ctrl_a.shape != ctrl_b.shape:
+        raise ValueError(f"Control point shapes must match: {ctrl_a.shape} vs {ctrl_b.shape}")
+
+    diff = ctrl_a - ctrl_b
+    num_segments = diff.shape[0]
+    M = BERNSTEIN_GRAM_4x4
+
+    w = img_w or 1.0
+    h = img_h or 1.0
+
+    errs_norm = []
+    errs_px = []
+
+    for s in range(num_segments):
+        dx = diff[s, :, 0]
+        dy = diff[s, :, 1]
+        e2_x = float(dx @ M @ dx)
+        e2_y = float(dy @ M @ dy)
+
+        e2_norm = max(0.0, e2_x + e2_y)
+        errs_norm.append(np.sqrt(e2_norm))
+
+        e2_px = max(0.0, (w ** 2) * e2_x + (h ** 2) * e2_y)
+        errs_px.append(np.sqrt(e2_px))
+
+    return float(np.mean(errs_norm)), float(np.mean(errs_px))
+
+
+def evaluate_spline_curve(ctrl_pts: np.ndarray, samples_per_segment: int = 40) -> np.ndarray:
+    """
+    Evaluate an N-segment cubic spline [N, 4, 2] at uniform parameter steps.
+    Returns: [N * samples_per_segment, 2] curve points.
+    """
+    num_segments = ctrl_pts.shape[0]
+    u = np.linspace(0.0, 1.0, samples_per_segment)
+    b0, b1, b2, b3 = cubic_bezier_basis(u)
+
+    curve_pts = []
+    for s in range(num_segments):
+        seg = ctrl_pts[s]
+        xs = b0 * seg[0, 0] + b1 * seg[1, 0] + b2 * seg[2, 0] + b3 * seg[3, 0]
+        ys = b0 * seg[0, 1] + b1 * seg[1, 1] + b2 * seg[2, 1] + b3 * seg[3, 1]
+        pts = np.column_stack([xs, ys])
+        curve_pts.append(pts)
+
+    return np.vstack(curve_pts)
+
+
+def draw_spline_curve(
+    bgr_img: np.ndarray,
+    ctrl_pts: np.ndarray,
+    color: tuple[int, int, int] = (0, 255, 0),
+    thickness: int = 2,
+    draw_dots: bool = False,
+    draw_tangents: bool = False,
+) -> None:
+    """
+    Render smooth N-segment cubic spline curves directly onto an image canvas.
+    """
+    h, w = bgr_img.shape[:2]
+    num_segments = ctrl_pts.shape[0]
+    u = np.linspace(0.0, 1.0, 40)
+    b0, b1, b2, b3 = cubic_bezier_basis(u)
+
+    for s in range(num_segments):
+        seg = ctrl_pts[s]
+        xs = (b0 * seg[0, 0] + b1 * seg[1, 0] + b2 * seg[2, 0] + b3 * seg[3, 0]) * w
+        ys = (b0 * seg[0, 1] + b1 * seg[1, 1] + b2 * seg[2, 1] + b3 * seg[3, 1]) * h
+        poly_pts = np.column_stack([xs, ys]).astype(np.int32)
+        cv2.polylines(bgr_img, [poly_pts], isClosed=False, color=color, thickness=thickness, lineType=cv2.LINE_AA)
+
+        if draw_tangents:
+            # Draw tangent handles between P0-P1 and P2-P3
+            p0 = (int(round(seg[0, 0] * w)), int(round(seg[0, 1] * h)))
+            p1 = (int(round(seg[1, 0] * w)), int(round(seg[1, 1] * h)))
+            p2 = (int(round(seg[2, 0] * w)), int(round(seg[2, 1] * h)))
+            p3 = (int(round(seg[3, 0] * w)), int(round(seg[3, 1] * h)))
+            cv2.line(bgr_img, p0, p1, (180, 180, 180), 1, cv2.LINE_AA)
+            cv2.line(bgr_img, p2, p3, (180, 180, 180), 1, cv2.LINE_AA)
+
+        if draw_dots:
+            for pt in seg:
+                px = int(round(pt[0] * w))
+                py = int(round(pt[1] * h))
+                cv2.circle(bgr_img, (px, py), 3, color, -1, lineType=cv2.LINE_AA)
+
+
+# --------------------------------------------------------------------------- #
+# Robust Centerline Extraction & Track Segmentation
+# --------------------------------------------------------------------------- #
+def extract_orange_pixels(
+    bgr_img: np.ndarray,
+    hsv_lower: tuple[int, int, int] = (0, 53, 145),
+    hsv_upper: tuple[int, int, int] = (7, 255, 255),
+    morph_open: bool = True,
+    bg_dim: float = 0.0,
+) -> tuple[np.ndarray, np.ndarray, int]:
+    """
+    Apply OpenCV 8-bit HSV thresholding to isolate orange track pixels.
+    Returns:
+        masked_img: BGR image showing only orange pixels (dimmed or black background).
+        mask: uint8 binary mask (0 or 255).
+        pixel_count: total number of orange pixels detected.
+    """
+    hsv = cv2.cvtColor(bgr_img, cv2.COLOR_BGR2HSV)
+    lower = np.array(hsv_lower, dtype=np.uint8)
+    upper = np.array(hsv_upper, dtype=np.uint8)
+    mask = cv2.inRange(hsv, lower, upper)
+
+    if morph_open:
+        kernel = np.ones((3, 3), np.uint8)
+        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)
+
+    if bg_dim > 0.0:
+        dimmed = (bgr_img.astype(np.float32) * bg_dim).astype(np.uint8)
+        masked_img = np.where(mask[:, :, None] > 0, bgr_img, dimmed)
+    else:
+        masked_img = cv2.bitwise_and(bgr_img, bgr_img, mask=mask)
+
+    pixel_count = int(np.count_nonzero(mask))
+    return masked_img, mask, pixel_count
+
+
+def compute_orange_pixel_error(
+    img_pred: np.ndarray,
+    img_base: np.ndarray,
+    hsv_lower: tuple[int, int, int] = (1, 53, 145),
+    hsv_upper: tuple[int, int, int] = (7, 255, 255),
+    morph_open: bool = True,
+) -> dict[str, float]:
+    """Calculate MAE, IoU, and Dice score between predicted and base orange masks."""
+    _, mask_pred, count_pred = extract_orange_pixels(img_pred, hsv_lower, hsv_upper, morph_open=morph_open)
+    _, mask_base, count_base = extract_orange_pixels(img_base, hsv_lower, hsv_upper, morph_open=morph_open)
+
+    intersection = np.logical_and(mask_pred > 0, mask_base > 0)
+    union = np.logical_or(mask_pred > 0, mask_base > 0)
+    inter_cnt = float(np.count_nonzero(intersection))
+    union_cnt = float(np.count_nonzero(union))
+
+    iou = inter_cnt / union_cnt if union_cnt > 0 else 1.0
+    dice = (2.0 * inter_cnt) / (count_pred + count_base) if (count_pred + count_base) > 0 else 1.0
+
+    if inter_cnt > 0:
+        pred_pts = img_pred[intersection].astype(np.float32)
+        base_pts = img_base[intersection].astype(np.float32)
+        mae = float(np.mean(np.abs(pred_pts - base_pts)))
+    else:
+        mae = float(np.mean(np.abs(img_pred.astype(np.float32) - img_base.astype(np.float32))))
+
+    return {
+        "mae": mae,
+        "iou": float(iou),
+        "dice": float(dice),
+        "count_pred": count_pred,
+        "count_base": count_base,
+    }
+
+
+def extract_skeleton_centerline(
+    mask: np.ndarray,
+    band_frac: float = 0.8,
+    min_mass: int = 30,
+    scale: float = 0.25,
+    num_samples: int = 48,
+) -> np.ndarray | None:
+    """
+    Extract continuous track centerline using morphological skeletonization and geodesic BFS graph traversal.
+    Handles hairpin turns and multi-lane intersections cleanly.
+    """
+    h, w = mask.shape[:2]
+    cutoff_y = int(round(h * (1.0 - band_frac)))
+    mask_cropped = mask.copy()
+    mask_cropped[:cutoff_y, :] = 0
+
+    # 1. Morphological close to bridge minor track discontinuities
+    close_kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (7, 7))
+    m_closed = cv2.morphologyEx(mask_cropped, cv2.MORPH_CLOSE, close_kernel)
+
+    # 2. Filter to largest connected component (eliminates isolated distant outliers/reflections)
+    num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(m_closed)
+    if num_labels <= 1:
+        return None
+    largest = 1 + np.argmax(stats[1:, cv2.CC_STAT_AREA])
+    if stats[largest, cv2.CC_STAT_AREA] < min_mass:
+        return None
+    clean_mask = np.where(labels == largest, 255, 0).astype(np.uint8)
+
+    m_small = cv2.resize(clean_mask, (0, 0), fx=scale, fy=scale, interpolation=cv2.INTER_NEAREST)
+    hs, ws = m_small.shape
+
+    # 3. Standard morphological skeletonization
+    skel = np.zeros_like(m_small)
+    element = cv2.getStructuringElement(cv2.MORPH_CROSS, (3, 3))
+    temp = m_small.copy()
+    while True:
+        eroded = cv2.erode(temp, element)
+        opened = cv2.morphologyEx(eroded, cv2.MORPH_OPEN, element)
+        subset = cv2.subtract(eroded, opened)
+        skel = cv2.bitwise_or(skel, subset)
+        temp = eroded
+        if cv2.countNonZero(temp) == 0:
+            break
+
+    # Filter skeleton to significant components (eliminate tiny 1-3 px detached nubs)
+    n_skel, l_skel, s_skel, _ = cv2.connectedComponentsWithStats(skel, connectivity=8)
+    if n_skel <= 1:
+        return None
+    max_skel_area = np.max(s_skel[1:, cv2.CC_STAT_AREA])
+    valid_comps = [i for i in range(1, n_skel) if s_skel[i, cv2.CC_STAT_AREA] >= max(5, int(max_skel_area * 0.05))]
+    if len(valid_comps) > 0:
+        skel = np.where(np.isin(l_skel, valid_comps), 255, 0).astype(np.uint8)
+
+    ys, xs = np.where(skel > 0)
+    if len(xs) < 15:
+        return None
+
+    skel_set = set(zip(xs.tolist(), ys.tolist()))
+    bottom_max_y = np.max(ys)
+    candidates = np.where(ys >= bottom_max_y - 8)[0]
+    start_idx = candidates[np.argmin(np.abs(xs[candidates] - ws / 2))]
+    start_pt = (int(xs[start_idx]), int(ys[start_idx]))
+
+    # 4. BFS graph traversal to find the longest continuous path along the track
+    visited = {start_pt: 0.0}
+    parent = {start_pt: None}
+    queue = deque([start_pt])
+    farthest_node = start_pt
+    max_dist = 0.0
+
+    while queue:
+        curr = queue.popleft()
+        cx, cy = curr
+        d_curr = visited[curr]
+        if d_curr > max_dist:
+            max_dist = d_curr
+            farthest_node = curr
+
+        for dx in range(-6, 7):
+            for dy in range(-6, 7):
+                if dx == 0 and dy == 0:
+                    continue
+                nbr = (cx + dx, cy + dy)
+                if nbr in skel_set and nbr not in visited:
+                    visited[nbr] = d_curr + np.hypot(dx, dy)
+                    parent[nbr] = curr
+                    queue.append(nbr)
+
+    path = []
+    curr = farthest_node
+    while curr is not None:
+        path.append(curr)
+        curr = parent[curr]
+    path.reverse()
+
+    if len(path) < 15 or max_dist < 20.0:
+        return None
+
+    pts = np.array([[pt[0] / ws, pt[1] / hs] for pt in path], dtype=np.float64)
+    return resample_path(pts, num_samples=num_samples)
+
+
+def synchronize_point_extents(
+    pts_a: np.ndarray | None,
+    pts_b: np.ndarray | None,
+) -> tuple[np.ndarray | None, np.ndarray | None]:
+    """
+    Truncate two extracted centerline point sets [N, 2] to their common vertical (y) domain.
+    Prevents artificial L2 error spikes caused by one curve extending slightly further
+    into the horizon or camera foreground than the other.
+    """
+    if pts_a is None or pts_b is None or len(pts_a) == 0 or len(pts_b) == 0:
+        return pts_a, pts_b
+
+    common_min_y = max(float(pts_a[:, 1].min()), float(pts_b[:, 1].min()))
+    common_max_y = min(float(pts_a[:, 1].max()), float(pts_b[:, 1].max()))
+
+    if common_min_y >= common_max_y:
+        return pts_a, pts_b
+
+    mask_a = (pts_a[:, 1] >= common_min_y) & (pts_a[:, 1] <= common_max_y)
+    mask_b = (pts_b[:, 1] >= common_min_y) & (pts_b[:, 1] <= common_max_y)
+
+    sub_a = pts_a[mask_a]
+    sub_b = pts_b[mask_b]
+
+    # Return truncated if sufficient points remain, else original
+    if len(sub_a) >= 15 and len(sub_b) >= 15:
+        return sub_a, sub_b
+    return pts_a, pts_b
+
+
+def extract_centerline_points(
+    mask: np.ndarray,
+    band_frac: float = 0.8,
+    min_mass: int = 15,
+    method: str = "scan",
+    max_jump_px: float = 120.0,
+    max_gap_rows: int = 25,
+    stitch_horizon_islands: bool = True,
+) -> np.ndarray | None:
+    """
+    Extract track centerline points from bottom to top within the vertical band fraction.
+
+    Features:
+        - Contiguous horizontal span/interval tracking (handles wide turns and hairpin curves without clipping).
+        - Trajectory-guided horizon island stitching (recovers thin distant track severed by sub-pixel noise).
+        - Resolution-adaptive overlap tolerances.
+
+    Args:
+        mask: uint8 binary mask (0 or 255).
+        band_frac: Vertical band fraction from bottom [0, 1].
+        min_mass: Minimum number of active pixels required.
+        method:
+          - 'scan': Robust contiguous span scanner with continuity tracking and horizon stitching.
+          - 'skeleton': Morphological skeletonization + geodesic BFS graph traversal.
+        max_jump_px: Maximum allowable horizontal displacement between consecutive rows.
+        max_gap_rows: Maximum consecutive empty rows before terminating upward traversal.
+        stitch_horizon_islands: Whether to stitch aligned distant track islands into the main component.
+
+    Returns:
+        pts: Array of shape [N, 2] in normalized coordinates [0, 1] x [0, 1], or None if track is absent.
+    """
+    if method == "skeleton":
+        pts = extract_skeleton_centerline(mask, band_frac=band_frac, min_mass=min_mass)
+        if pts is not None:
+            return pts
+
+    h, w = mask.shape[:2]
+    if np.count_nonzero(mask) < min_mass:
+        return None
+
+    cutoff_y = int(round(h * (1.0 - band_frac)))
+    mask_cropped = mask.copy()
+    mask_cropped[:cutoff_y, :] = 0
+
+    # 1. Morphological closing to bridge minor tears along the track
+    close_kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (11, 11))
+    m_closed = cv2.morphologyEx(mask_cropped, cv2.MORPH_CLOSE, close_kernel)
+    num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(m_closed)
+    if num_labels <= 1:
+        return None
+    largest = 1 + np.argmax(stats[1:, cv2.CC_STAT_AREA])
+    if stats[largest, cv2.CC_STAT_AREA] < min_mass:
+        return None
+    active_mask = np.where(labels == largest, 255, 0).astype(np.uint8)
+
+    # 2. Trajectory-guided horizon island stitching
+    # In real photos, perspective causes distant track to thin to 2-3 px, creating tiny breaks.
+    # We iteratively fuse candidate components that align with the forward trajectory of the track.
+    if stitch_horizon_islands:
+        while True:
+            ys, xs = np.where(active_mask > 0)
+            if len(ys) == 0:
+                break
+            top_y = ys.min()
+            top_xs = xs[ys <= top_y + 8]
+            top_center_x = float(np.mean(top_xs))
+
+            best_candidate = None
+            min_dist = float("inf")
+            for label_id in range(1, num_labels):
+                if stats[label_id, cv2.CC_STAT_AREA] < 25:
+                    continue
+                c_stat = stats[label_id]
+                c_top = c_stat[cv2.CC_STAT_TOP]
+                c_bottom = c_top + c_stat[cv2.CC_STAT_HEIGHT]
+                c_center_x = c_stat[cv2.CC_STAT_LEFT] + c_stat[cv2.CC_STAT_WIDTH] / 2.0
+
+                gap_y = top_y - c_bottom
+                # Candidate must lie above or slightly overlap top_y, and extend higher into the horizon
+                if -25 <= gap_y <= 35 and c_top < top_y:
+                    gap_x = abs(c_center_x - top_center_x)
+                    if gap_x <= max(150.0, w * 0.05):
+                        dist = abs(gap_y) + gap_x * 0.2
+                        if dist < min_dist:
+                            min_dist = dist
+                            best_candidate = label_id
+
+            if best_candidate is not None:
+                active_mask = np.where(labels == best_candidate, 255, active_mask)
+                stats[best_candidate, cv2.CC_STAT_AREA] = 0  # Consume candidate
+            else:
+                break
+
+    # 3. Contiguous horizontal span/interval tracking from bottom to top
+    pts = []
+    last_span = None  # (min_x, max_x, center_x)
+    gap_count = 0
+    overlap_margin = max(35.0, w * 0.025)
+    max_jump = max(max_jump_px, w * 0.05)
+
+    for y in range(h - 1, cutoff_y - 1, -1):
+        xs = np.where(active_mask[y, :] > 0)[0]
+        if len(xs) > 0:
+            # Segment row pixels into contiguous runs (split where gap between adjacent pixels > 15px)
+            splits = np.where(np.diff(xs) > 15)[0]
+            runs = [(float(r.min()), float(r.max()), float(r.mean())) for r in np.split(xs, splits + 1)]
+
+            if last_span is not None:
+                prev_min, prev_max, prev_center = last_span
+                best_run = None
+                best_dist = float("inf")
+
+                # Check for direct horizontal overlap/adjacency with previous row
+                for r_min, r_max, r_center in runs:
+                    if r_min <= prev_max + overlap_margin and r_max >= prev_min - overlap_margin:
+                        dist = abs(r_center - prev_center)
+                        if dist < best_dist:
+                            best_dist = dist
+                            best_run = (r_min, r_max, r_center)
+
+                # Fallback: closest run by edge-to-edge distance
+                if best_run is None:
+                    for r_min, r_max, r_center in runs:
+                        dist = min(abs(r_min - prev_max), abs(r_max - prev_min))
+                        if dist < best_dist:
+                            best_dist = dist
+                            best_run = (r_min, r_max, r_center)
+
+                # Reject jumps larger than max_jump
+                if best_dist > max_jump:
+                    gap_count += 1
+                    if gap_count > max_gap_rows:
+                        break
+                    continue
+
+                last_span = best_run
+                pts.append([best_run[2] / w, float(y) / h])
+                gap_count = 0
+            else:
+                # Bottom-most row: pick run closest to image center
+                best_run = min(runs, key=lambda r: abs(r[2] - w / 2.0))
+                last_span = best_run
+                pts.append([best_run[2] / w, float(y) / h])
+                gap_count = 0
+        else:
+            if last_span is not None:
+                gap_count += 1
+                if gap_count > max_gap_rows:
+                    break
+
+    if len(pts) < 15:
+        return None
+    return np.array(pts, dtype=np.float64)
+
+
+# --------------------------------------------------------------------------- #
+# Differentiable PyTorch Pipeline (for simple_trainer.py training loop)
+# --------------------------------------------------------------------------- #
+if TORCH_AVAILABLE:
+    BERNSTEIN_GRAM_4x4_TORCH = torch.tensor(
+        [
+            [20.0, 10.0, 4.0, 1.0],
+            [10.0, 12.0, 9.0, 4.0],
+            [4.0, 9.0, 12.0, 10.0],
+            [1.0, 4.0, 10.0, 20.0],
+        ],
+        dtype=torch.float32,
+    ) / 140.0
+
+    def cubic_bezier_basis_torch(u: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+        """Cubic Bernstein basis functions for u in [0, 1] on PyTorch tensors."""
+        u_c = torch.clamp(u, 0.0, 1.0)
+        one_minus_u = 1.0 - u_c
+        b0 = one_minus_u ** 3
+        b1 = 3.0 * (one_minus_u ** 2) * u_c
+        b2 = 3.0 * one_minus_u * (u_c ** 2)
+        b3 = u_c ** 3
+        return b0, b1, b2, b3
+
+    def compute_chord_parameters_torch(points: torch.Tensor) -> torch.Tensor:
+        """Compute normalized chord-length parameter u in [0, 1] for points: [N, 2]."""
+        diffs = points[1:] - points[:-1]
+        chord_lengths = torch.norm(diffs, dim=-1)
+        cum = torch.cat([torch.zeros(1, dtype=points.dtype, device=points.device), torch.cumsum(chord_lengths, dim=0)])
+        total_length = cum[-1]
+        safe_total = torch.where(total_length > 1e-7, total_length, torch.ones_like(total_length))
+        return torch.clamp(cum / safe_total, 0.0, 1.0)
+
+    def fit_n_cubic_splines_torch(
+        points: torch.Tensor,
+        num_segments: int = 3,
+        continuity: str = "C1",
+        pin_endpoints: bool = True,
+        reg_lambda: float = 1e-6,
+    ) -> torch.Tensor:
+        """
+        Differentiable global linear least-squares fitting of N cubic Bézier segments to 2D points.
+        Guarantees exact C0 (position) and C1 (tangent vector) continuity at all internal junctions.
+        Fully backpropagatable through torch.linalg.solve.
+
+        Args:
+            points: [N_pts, 2] tensor of 2D points in normalized coordinates [0, 1] x [0, 1].
+            num_segments: Number of cubic segments N >= 1.
+            continuity: 'C1' (tangent vector continuity) or 'C0' (position continuity).
+            pin_endpoints: If True, fixes curve start to points[0] and end to points[-1].
+            reg_lambda: Tikhonov regularization factor for AtA inversion.
+
+        Returns:
+            ctrl_pts: [num_segments, 4, 2] control points tensor.
+        """
+        device = points.device
+        dtype = points.dtype
+        n_pts = points.shape[0]
+
+        if n_pts < 4:
+            p0 = points[0]
+            p3 = points[-1]
+            t_vals = torch.linspace(0.0, 1.0, num_segments + 1, dtype=dtype, device=device)
+            juncs = [p0 + (p3 - p0) * t for t in t_vals]
+            out = []
+            for s in range(num_segments):
+                s0 = juncs[s]
+                s3 = juncs[s + 1]
+                s1 = s0 + (s3 - s0) * (1.0 / 3.0)
+                s2 = s0 + (s3 - s0) * (2.0 / 3.0)
+                out.append(torch.stack([s0, s1, s2, s3], dim=0))
+            return torch.stack(out, dim=0)
+
+        u_global = compute_chord_parameters_torch(points)
+        seg_breaks = torch.linspace(0.0, 1.0, num_segments + 1, dtype=dtype, device=device)
+
+        seg_indices = torch.clamp(torch.floor(u_global * num_segments).long(), 0, num_segments - 1)
+        seg_start = seg_breaks[seg_indices]
+        seg_len = seg_breaks[seg_indices + 1] - seg_start
+        u_local = torch.clamp((u_global - seg_start) / seg_len, 0.0, 1.0)
+
+        b0, b1, b2, b3 = cubic_bezier_basis_torch(u_local)
+        basis = torch.stack([b0, b1, b2, b3], dim=-1)  # [N, 4]
+
+        n_vars = 2 * num_segments if pin_endpoints else 2 * num_segments + 2
+        coeff = torch.zeros((num_segments, 4, n_vars), dtype=dtype, device=device)
+        const = torch.zeros((num_segments, 4, 2), dtype=dtype, device=device)
+
+        p_start = points[0]
+        p_end = points[-1]
+
+        if continuity.upper() == "C1":
+            if pin_endpoints:
+                const[0, 0] = p_start
+                coeff[0, 1, 0] = 1.0
+                coeff[0, 2, 1] = 1.0
+                if num_segments == 1:
+                    const[0, 3] = p_end
+                else:
+                    coeff[0, 3, 2] = 1.0
+                for s in range(1, num_segments):
+                    idx_Js = 2 * s
+                    idx_prev_p2 = 2 * s - 1
+                    idx_ps2 = 2 * s + 1
+                    coeff[s, 0, idx_Js] = 1.0
+                    coeff[s, 1, idx_Js] += 2.0
+                    coeff[s, 1, idx_prev_p2] -= 1.0
+                    coeff[s, 2, idx_ps2] = 1.0
+                    if s == num_segments - 1:
+                        const[s, 3] = p_end
+                    else:
+                        coeff[s, 3, 2 * (s + 1)] = 1.0
+            else:
+                coeff[0, 0, 0] = 1.0
+                coeff[0, 1, 1] = 1.0
+                coeff[0, 2, 2] = 1.0
+                coeff[0, 3, 3] = 1.0
+                for s in range(1, num_segments):
+                    idx_Js = 2 * s + 1
+                    idx_prev_p2 = 2 * s
+                    idx_ps2 = 2 * s + 2
+                    coeff[s, 0, idx_Js] = 1.0
+                    coeff[s, 1, idx_Js] += 2.0
+                    coeff[s, 1, idx_prev_p2] -= 1.0
+                    coeff[s, 2, idx_ps2] = 1.0
+                    if s == num_segments - 1:
+                        coeff[s, 3, 2 * s + 3] = 1.0
+                    else:
+                        coeff[s, 3, 2 * (s + 1) + 1] = 1.0
+        else:
+            n_vars = 3 * num_segments - 1 if pin_endpoints else 3 * num_segments + 1
+            coeff = torch.zeros((num_segments, 4, n_vars), dtype=dtype, device=device)
+            const = torch.zeros((num_segments, 4, 2), dtype=dtype, device=device)
+            const[0, 0] = p_start
+            var_idx = 0
+            for s in range(num_segments):
+                if s > 0:
+                    coeff[s, 0] = coeff[s - 1, 3]
+                coeff[s, 1, var_idx] = 1.0
+                var_idx += 1
+                coeff[s, 2, var_idx] = 1.0
+                var_idx += 1
+                if s == num_segments - 1 and pin_endpoints:
+                    const[s, 3] = p_end
+                else:
+                    coeff[s, 3, var_idx] = 1.0
+                    var_idx += 1
+
+        coeff_pts = coeff[seg_indices]
+        const_pts = const[seg_indices]
+
+        A = torch.sum(basis.unsqueeze(-1) * coeff_pts, dim=1)
+        offset = torch.sum(basis.unsqueeze(-1) * const_pts, dim=1)
+        B = points - offset
+
+        AtA = A.t() @ A
+        AtB = A.t() @ B
+        reg = torch.eye(n_vars, dtype=dtype, device=device) * reg_lambda
+        X = torch.linalg.solve(AtA + reg, AtB)
+
+        ctrl_pts = torch.einsum("skv, vd -> skd", coeff, X) + const
+        return ctrl_pts
+
+    def fit_three_cubic_bsplines_torch(pts: torch.Tensor) -> torch.Tensor:
+        """Backward-compatible alias: fit 3 C1 cubic splines to pts: [N, 2]."""
+        return fit_n_cubic_splines_torch(pts, num_segments=3, continuity="C1")
+
+    def exact_integrated_l2_error_torch(
+        ctrl_render: torch.Tensor,
+        ctrl_target: torch.Tensor,
+        img_w: float | None = None,
+        img_h: float | None = None,
+    ) -> tuple[torch.Tensor, torch.Tensor] | torch.Tensor:
+        """
+        Exact integrated L2 error between two cubic B-spline curves using the Gram matrix.
+        ctrl_render: [num_segments, 4, 2]
+        ctrl_target: [num_segments, 4, 2]
+        If img_w and img_h are provided, returns (err_norm, err_px).
+        """
+        M = BERNSTEIN_GRAM_4x4_TORCH.to(dtype=ctrl_render.dtype, device=ctrl_render.device)
+        diff = ctrl_render - ctrl_target
+
+        seg_errors = []
+        seg_errors_px = []
+        for s in range(diff.shape[0]):
+            dx = diff[s, :, 0]
+            dy = diff[s, :, 1]
+            err2_x = dx @ M @ dx
+            err2_y = dy @ M @ dy
+            err2_norm = err2_x + err2_y
+            seg_errors.append(torch.sqrt(err2_norm.clamp_min(1e-8)))
+            if img_w is not None and img_h is not None:
+                err2_px = (img_w**2) * err2_x + (img_h**2) * err2_y
+                seg_errors_px.append(torch.sqrt(err2_px.clamp_min(1e-8)))
+
+        err_norm = torch.stack(seg_errors).mean()
+        if img_w is not None and img_h is not None:
+            err_px = torch.stack(seg_errors_px).mean()
+            return err_norm, err_px
+        return err_norm
+
+    compute_exact_integrated_l2_torch = exact_integrated_l2_error_torch
+
+    def rgb_to_hsv_torch(rgb: torch.Tensor) -> torch.Tensor:
+        """Differentiable RGB -> HSV conversion in OpenCV conventions [0..180, 0..255, 0..255]."""
+        r, g, b = rgb.unbind(dim=-1)
+        max_val, _ = torch.max(rgb, dim=-1)
+        min_val, _ = torch.min(rgb, dim=-1)
+        c = max_val - min_val
+        v = max_val
+        s = torch.where(max_val > 1e-6, c / (max_val + 1e-6), torch.zeros_like(max_val))
+        h = torch.where(
+            c < 1e-6,
+            torch.zeros_like(c),
+            torch.where(
+                max_val == r,
+                ((g - b) / (c + 1e-6)) % 6.0,
+                torch.where(
+                    max_val == g,
+                    ((b - r) / (c + 1e-6)) + 2.0,
+                    ((r - g) / (c + 1e-6)) + 4.0,
+                ),
+            ),
+        )
+        h = torch.where(c > 1e-6, h * 30.0, torch.zeros_like(h))
+        return torch.stack([h, s * 255.0, v * 255.0], dim=-1)
+
+    def soft_orange_mask_torch(
+        images: torch.Tensor,
+        hsv_lower=(0, 110, 100),
+        hsv_upper=(19, 255, 255),
+        tau=(2.5, 10.0, 10.0),
+    ) -> torch.Tensor:
+        """
+        images: [B, H, W, 3] RGB float tensor in [0, 1].
+        Returns soft probability mask: [B, H, W] in [0, 1].
+        """
+        hsv = rgb_to_hsv_torch(images)
+        lo = torch.tensor(hsv_lower, dtype=hsv.dtype, device=hsv.device)
+        hi = torch.tensor(hsv_upper, dtype=hsv.dtype, device=hsv.device)
+        t = torch.tensor(tau, dtype=hsv.dtype, device=hsv.device)
+
+        m = (torch.sigmoid((hsv - lo) / t) * torch.sigmoid((hi - hsv) / t)).prod(dim=-1)
+        m = m.unsqueeze(1)  # [B, 1, H, W]
+
+        # Soft morphology open: erode (min_pool) followed by dilate (max_pool)
+        m = -F.max_pool2d(-m, kernel_size=3, stride=1, padding=1)
+        m = F.max_pool2d(m, kernel_size=3, stride=1, padding=1)
+        return m.squeeze(1)  # [B, H, W]
+
+    def extract_centerline_points_torch(
+        mask: torch.Tensor,
+        band_frac: float = 0.8,
+        num_rows: int = 36,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """
+        Extract centerline points starting from the bottom of the image towards the top.
+        mask: [H, W] soft orange mask in [0, 1].
+        band_frac: height fraction measured from the bottom of the image.
+        num_rows: number of sample rows to extract.
+
+        Returns:
+            pts: [num_rows, 2] in normalized coordinates [0, 1] x [0, 1]
+            row_mass: [num_rows] sum of weights across each row
+        """
+        H, W = mask.shape
+        band_h = max(num_rows, int(round(H * band_frac)))
+
+        y_indices = torch.linspace(H - 1, H - band_h, steps=num_rows, device=mask.device).round().long()
+        y_indices = y_indices.clamp(0, H - 1)
+
+        row_slices = mask[y_indices, :]  # [num_rows, W]
+        row_mass = row_slices.sum(dim=-1)  # [num_rows]
+
+        x_coords = torch.arange(W, dtype=mask.dtype, device=mask.device)
+        expected_x = (row_slices * x_coords).sum(dim=-1) / row_mass.clamp_min(1e-6)
+
+        norm_x = expected_x / float(max(1, W - 1))
+        norm_y = y_indices.to(mask.dtype) / float(max(1, H - 1))
+
+        pts = torch.stack([norm_x, norm_y], dim=-1)  # [num_rows, 2]
+        return pts, row_mass
+
+    def spline_loss_torch(
+        render: torch.Tensor | None = None,
+        target: torch.Tensor | None = None,
+        band_frac: float = 0.8,
+        hsv_lower=(0, 110, 100),
+        hsv_upper=(19, 255, 255),
+        min_frac: float = 0.002,
+        tau=(2.5, 10.0, 10.0),
+        mask_render: torch.Tensor | None = None,
+        mask_target: torch.Tensor | None = None,
+        num_segments: int = 3,
+        continuity: str = "C1",
+    ) -> torch.Tensor:
+        """
+        Differentiable spline loss fitting N tangent-continuous cubic splines to render and target.
+        """
+        if mask_render is None:
+            assert render is not None, "Either render or mask_render must be provided"
+            mask_render = soft_orange_mask_torch(render, hsv_lower, hsv_upper, tau)
+        if mask_target is None:
+            assert target is not None, "Either target or mask_target must be provided"
+            mask_target = soft_orange_mask_torch(target.detach(), hsv_lower, hsv_upper, tau)
+
+        B, H, W = mask_render.shape
+        losses = []
+        min_mass = min_frac * H * W * band_frac
+
+        for b in range(B):
+            m_r = mask_render[b]
+            m_t = mask_target[b]
+
+            mass_r = m_r.sum()
+            mass_t = m_t.sum()
+
+            if mass_t < min_mass or mass_r < min_mass:
+                continue
+
+            pts_t, _ = extract_centerline_points_torch(m_t, band_frac=band_frac)
+            ctrl_t = fit_n_cubic_splines_torch(pts_t, num_segments=num_segments, continuity=continuity).detach()
+
+            pts_r, _ = extract_centerline_points_torch(m_r, band_frac=band_frac)
+            ctrl_r = fit_n_cubic_splines_torch(pts_r, num_segments=num_segments, continuity=continuity)
+
+            l2_err = exact_integrated_l2_error_torch(ctrl_r, ctrl_t)
+            losses.append(l2_err)
+
+        if not losses:
+            return mask_render.sum() * 0.0
+        return torch.stack(losses).mean()
+
+    def eval_spline_error_torch(
+        render: torch.Tensor,
+        target: torch.Tensor,
+        band_frac: float = 0.8,
+        hsv_lower=(0, 110, 100),
+        hsv_upper=(19, 255, 255),
+        min_frac: float = 0.002,
+        num_segments: int = 3,
+        continuity: str = "C1",
+    ) -> tuple[torch.Tensor, torch.Tensor] | tuple[None, None]:
+        """Non-training evaluation: returns (err_norm, err_px) or (None, None) if track missing."""
+        with torch.no_grad():
+            m_r = soft_orange_mask_torch(render.unsqueeze(0), hsv_lower, hsv_upper)[0]
+            m_t = soft_orange_mask_torch(target.unsqueeze(0), hsv_lower, hsv_upper)[0]
+            H, W = m_r.shape
+            min_mass = min_frac * H * W * band_frac
+            if m_t.sum() < min_mass or m_r.sum() < min_mass:
+                return None, None
+            pts_r, _ = extract_centerline_points_torch(m_r, band_frac)
+            pts_t, _ = extract_centerline_points_torch(m_t, band_frac)
+            ctrl_r = fit_n_cubic_splines_torch(pts_r, num_segments=num_segments, continuity=continuity)
+            ctrl_t = fit_n_cubic_splines_torch(pts_t, num_segments=num_segments, continuity=continuity)
+            return exact_integrated_l2_error_torch(ctrl_r, ctrl_t, img_w=float(W), img_h=float(H))
+
+
+# --------------------------------------------------------------------------- #
+# Standalone CLI Interface
+# --------------------------------------------------------------------------- #
+def main():
+    parser = argparse.ArgumentParser(
+        description="Fit N tangent-continuous (C1) cubic B-splines to orange track in image."
+    )
+    parser.add_argument("image", type=Path, help="Path to input track image (.jpg or .png)")
+    parser.add_argument("-o", "--output", type=Path, default=None, help="Save visualization to file")
+    parser.add_argument("-n", "--segments", type=int, default=3, help="Number of cubic spline segments (default: 3)")
+    parser.add_argument("--continuity", choices=["C0", "C1"], default="C1", help="Continuity level: 'C1' (tangent) or 'C0'")
+    parser.add_argument("--band-frac", type=float, default=0.8, help="Vertical band fraction from bottom (default: 0.8)")
+    parser.add_argument("--hsv-lower", nargs=3, type=int, default=[1, 53, 145], metavar=("H", "S", "V"), help="Lower HSV limit")
+    parser.add_argument("--hsv-upper", nargs=3, type=int, default=[7, 255, 255], metavar=("H", "S", "V"), help="Upper HSV limit")
+    parser.add_argument("--method", choices=["scan", "skeleton"], default="scan", help="Centerline method")
+
+    args = parser.parse_args()
+
+    if not args.image.exists():
+        print(f"[Error] Image not found: {args.image}")
+        sys.exit(1)
+
+    img = cv2.imread(str(args.image))
+    if img is None:
+        print(f"[Error] Failed to load image: {args.image}")
+        sys.exit(1)
+
+    h, w = img.shape[:2]
+    print(f"\nLoaded image: {args.image.name} ({w}x{h})")
+
+    # Segment orange track
+    masked_img, mask, count = extract_orange_pixels(img, tuple(args.hsv_lower), tuple(args.hsv_upper))
+    print(f"Detected orange pixels: {count:,} px")
+
+    pts = extract_centerline_points(mask, band_frac=args.band_frac, method=args.method)
+    if pts is None or len(pts) < 10:
+        print("[Error] Failed to extract sufficient centerline points.")
+        sys.exit(1)
+
+    print(f"Extracted {len(pts)} centerline points using '{args.method}' method.")
+    ctrl_pts = fit_n_cubic_splines(pts, num_segments=args.segments, continuity=args.continuity)
+    print(f"Fitted {args.segments} {args.continuity}-continuous cubic spline segments.")
+    print(f"Control points shape: {ctrl_pts.shape}")
+
+    for s in range(args.segments):
+        print(f"\n--- Segment {s + 1} (4 Control Points) ---")
+        for k in range(4):
+            nx, ny = ctrl_pts[s, k]
+            px, py = nx * w, ny * h
+            print(f"  P{k}: norm=({nx:.4f}, {ny:.4f}) -> pixel=({px:.1f}px, {py:.1f}px)")
+
+    # Render on copy of image
+    vis = img.copy()
+    draw_spline_curve(vis, ctrl_pts, color=(0, 255, 0), thickness=3, draw_dots=True, draw_tangents=True)
+
+    if args.output:
+        cv2.imwrite(str(args.output), vis)
+        print(f"\nSaved visualization to: {args.output}")
+
+
+if __name__ == "__main__":
+    main()
